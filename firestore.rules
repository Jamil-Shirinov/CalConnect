rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user can view profiles (needed for browsing matches);
    // only the owner can create or edit their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
