# Copy this file to .env and fill in the values. Never commit .env.

PORT=3000
FIREBASE_PROJECT_ID=calconnect-1a99f

# --- Local development (Firebase emulators) ---
# Keep these two lines while running `firebase emulators:start`.
# The Admin SDK then talks to the emulators and needs no key file.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Real Firebase project ---
# Comment out the two emulator lines above and point this at the
# service account key JSON (ask the backend PM; never commit it).
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
