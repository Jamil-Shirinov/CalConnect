rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user can view profiles (needed for browsing matches);
    // only the owner can create or edit their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /announcements/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == id
        && request.resource.data.keys().hasOnly(
             ['id', 'title', 'description', 'category', 'userId', 'createdAt', 'site', 'adminOnly'])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.createdAt is number
        && request.resource.data.adminOnly is bool;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
