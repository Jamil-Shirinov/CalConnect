rules_version = '2';

// Follows the CalConnect Data Model spec. Anything not allowed here is
// denied. Writes marked "server only" go through Express with the Admin SDK,
// which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.participants;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Any signed-in user can read profiles (needed for match cards). Users
    // create and edit only their own, with a @berkeley.edu email, and can
    // never change their role after signup.
    // MVP: email verification isn't required yet. After the demo, add
    // `&& request.auth.token.email_verified == true` to create.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.matches('.*@berkeley[.]edu$')
        && request.resource.data.role in ['student', 'tutor'];
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['uid', 'email', 'role', 'createdAt']);
    }

    // Created by the server (status "suggested"). Participants move it along
    // suggested -> requested -> accepted/declined; the person who sent the
    // request can't answer it. score and reasons are server only.
    match /matches/{matchId} {
      allow read: if isParticipant(resource.data);
      allow update: if isParticipant(resource.data)
        && changedOnly(['status', 'requestedBy', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.status == 'suggested'
            && request.resource.data.status == 'requested'
            && request.resource.data.requestedBy == request.auth.uid)
          ||
          (resource.data.status == 'requested'
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.requestedBy == resource.data.requestedBy
            && resource.data.requestedBy != request.auth.uid)
        );

      // Chat between the two people once the match is accepted.
      // Messages can't be edited or deleted.
      match /messages/{messageId} {
        function parentMatch() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function canChat() {
          return isParticipant(parentMatch()) && parentMatch().status == 'accepted';
        }

        allow read: if canChat();
        allow create: if canChat()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
      }
    }

    // Created by the server (POST /sessions does the conflict check).
    // Participants can only change status: the other person confirms, either
    // can cancel, and a confirmed session can be completed once it has ended.
    match /sessions/{sessionId} {
      allow read: if isParticipant(resource.data);
      allow update: if isParticipant(resource.data)
        && changedOnly(['status'])
        && (
          (resource.data.status == 'proposed'
            && request.resource.data.status == 'confirmed'
            && resource.data.proposedBy != request.auth.uid)
          ||
          (resource.data.status in ['proposed', 'confirmed']
            && request.resource.data.status == 'cancelled')
          ||
          (resource.data.status == 'confirmed'
            && request.resource.data.status == 'completed'
            && request.time > resource.data.end)
        );
    }

    // Created by the server (POST /announcements fills in audience and sends
    // email). Readable by the posting tutor and the students in audience.
    match /announcements/{announcementId} {
      allow read: if signedIn()
        && (resource.data.tutorId == request.auth.uid
            || request.auth.uid in resource.data.audience);
      allow delete: if signedIn() && resource.data.tutorId == request.auth.uid;
    }

    // feedback: not opened yet (phase 3). All access is denied until then.
  }
}
